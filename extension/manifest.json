{
  "manifest_version": 3,

  "name": "NoTopo Prospect Intelligence",

  "version": "1.0.0",

  "description": "CRM para prospecção B2B via LinkedIn desenvolvido pela NoTopo.",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
       "storage.js",
    "modules/companies.js",
    "modules/companyDetector.js",
    "modules/personDetector.js",
    "ui/panel.js",
    "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "NoTopo Prospect Intelligence",
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}